// Al Athaq Boutique — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  image
  video
  svg
}

model SiteSettings {
  id String @id @default("default")

  tagline String @default("Tradition you can carry home.")

  heroEyebrow  String
  heroTitle    String
  heroSubtitle String
  heroMediaUrl String
  heroMediaType MediaType @default(image)
  heroPosterUrl String?

  ctaPrimaryLabel  String
  ctaPrimaryHref   String
  ctaSecondaryLabel String
  ctaSecondaryHref  String

  storyHeading    String
  storyParagraph1 String
  storyParagraph2 String
  storyCtaLabel   String
  storyCtaHref    String
  storyMediaUrl   String
  storyMediaType  MediaType @default(image)
  storyPosterUrl  String?
  storyBgUrl      String
  storyBgType     MediaType @default(image)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Featured homepage slots — up to 4 tagged products (position 1–4).
model Featured {
  id        String   @id @default(cuid())
  /// Slot tag: 1 (large), 2 (wide), 3 (small A), 4 (small B)
  position  Int      @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([position])
}

model Product {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  category    String
  mediaUrl    String
  mediaType   MediaType  @default(image)
  posterUrl   String?
  alt         String
  sortOrder   Int        @default(0)
  featured    Featured[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([slug])
  @@index([category])
}

model AdminUser {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
}
