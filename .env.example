# Shared (Next + Express)
# Neon PostgreSQL — same database for storefront and admin API
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Next.js (storefront + /my-access-nimda UI) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Express API origin (no trailing slash)
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Shared with Express for on-demand ISR after product mutations
REVALIDATE_SECRET="replace-with-long-random-string"

# --- Express API (apps/api) ---
PORT=4000
JWT_SECRET="replace-with-long-random-secret-min-16-chars"
FRONTEND_URL="http://localhost:3000"
PASSWORD_MAX_AGE_DAYS=5
# Bootstrap admin (seed only — hashed into AdminUser; never used as live plaintext auth)
ADMIN_EMAIL="adnan.akhonbay@gmail.com"
ADMIN_BOOTSTRAP_PASSWORD="alathaqboutique@1234"
# Optional: URL Express POSTs after product CRUD
NEXT_REVALIDATE_URL="http://localhost:3000/api/revalidate"

# Mailgun (Express only — never expose to the browser)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM="Al Athaq Boutique <noreply@your-mailgun-domain>"
