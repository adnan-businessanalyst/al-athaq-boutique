/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.cert

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env / secrets (keep .env.example tracked)
.env
.env.*
!.env.example
*.local

