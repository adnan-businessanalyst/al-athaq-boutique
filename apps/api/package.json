    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "form-data": "^4.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^12.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "prisma": "5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5"
